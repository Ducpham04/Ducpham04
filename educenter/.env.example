# Sao chép thành .env rồi chỉnh. KHÔNG commit file .env.
DB_NAME=educenter
DB_USERNAME=educenter
DB_PASSWORD=educenter
DB_ROOT_PASSWORD=root-change-me

# Bắt buộc đổi khi triển khai thật: chuỗi ngẫu nhiên >= 32 ký tự (openssl rand -base64 48)
JWT_SECRET=change-this-secret-in-production-min-32-bytes!!

# true: tạo dữ liệu demo khi database trống
APP_SEED_DEMO=true
APP_CORS_ORIGINS=http://localhost:3000

# SMTP – mặc định dùng Mailpit (xem email tại http://localhost:8025)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=EduCenter <no-reply@educenter.vn>

# mock | (real – xem README để tích hợp Zalo ZNS thật)
ZALO_MODE=mock
SPRINGDOC_ENABLED=true
