# Sao chép thành .env rồi chỉnh sửa. Mọi giá trị đều có mặc định cho môi trường dev.
DB_NAME=bookeasy
DB_USERNAME=bookeasy
DB_PASSWORD=bookeasy
DB_ROOT_PASSWORD=rootpass
MYSQL_PORT=3307

# BẮT BUỘC đổi ở production: chuỗi ngẫu nhiên >= 32 ký tự (openssl rand -base64 48)
JWT_SECRET=change-me-in-production-at-least-32-bytes-long

PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Khóa xác thực webhook SePay (Authorization: Apikey <key>) / Casso (Secure-Token)
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
# Tắt ở production: nút "Giả lập đã chuyển khoản"
PAYMENT_MOCK_ENABLED=true

# Dữ liệu demo tiếng Việt (chỉ chạy khi DB trống)
APP_SEED_DEMO=true

MAIL_FROM=BookEasy <no-reply@bookeasy.vn>
